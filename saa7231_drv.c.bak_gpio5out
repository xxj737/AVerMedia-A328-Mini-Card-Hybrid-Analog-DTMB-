	MAKE_ENTRY(BLACKGOLD_TECHNOLOGY, BLACKGOLD_BGT3575, SAA7231, &purus_blackgold_bgt3575),
	MAKE_ENTRY(BLACKGOLD_TECHNOLOGY, BLACKGOLD_BGT3576, SAA7231, &purus_blackgold_bgt3576),
